# Dockerfile for Orchestration Engine
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY src/symbiote/tsconfig.json ./src/symbiote/

# Install dependencies
RUN npm ci

# Copy orchestration source
COPY src/symbiote/orchestration/ ./src/symbiote/orchestration/
COPY src/symbiote/utils/ ./src/symbiote/utils/
COPY src/types/ ./src/types/

# Build
RUN npm run build

# Production stage
FROM node:20-alpine

RUN apk add --no-cache curl

WORKDIR /app

# Copy built files
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package*.json ./

# Expose port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Environment
ENV NODE_ENV=production
ENV PORT=9000

# Start service
CMD ["node", "dist/symbiote/orchestration/index.js"]